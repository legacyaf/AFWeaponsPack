// Material for the AF-7 body. Uses the standard "Super" shader layout.
// Compare against a vanilla weapon .rvmat (e.g. P:\DZ\weapons\firearms\m4\data\*.rvmat)
// and copy any values that look different - vanilla is the source of truth.
//
// Texture files you make (all .paa, same size, e.g. 2048x2048 or 4096x4096):
//   af7_body_co.paa    colour (albedo)
//   af7_body_nohq.paa  normal map
//   af7_body_smdi.paa  specular / gloss (green = specular, blue = gloss)
//   af7_body_as.paa    ambient occlusion

ambient[] = {1, 1, 1, 1};
diffuse[] = {1, 1, 1, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0, 0, 0, 0};
specular[] = {0.7, 0.7, 0.7, 1};
specularPower = 80;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_nohq.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage2
{
	texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,DT)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage3
{
	texture = "#(argb,8,8,3)color(0,0,0,0,MC)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage4
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_as.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage5
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_smdi.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage6
{
	texture = "#(ai,64,64,1)fresnel(1.5,0.7)";
	uvSource = "none";
};
class Stage7
{
	texture = "DZ\data\data\env_land_co.paa";   // VERIFY path against a vanilla rvmat
	useWorldEnvMap = "true";
	uvSource = "none";
};
