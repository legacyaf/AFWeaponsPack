// Material for the AF-7 body ("Super" shader).
// Every value below is copied from the vanilla M4 material
// (dz\weapons\firearms\m4\data\m4_body.rvmat); only the texture paths differ.
//
// Textures (made by blender/af7_vanguard_dayz_export.py, then converted to .paa):
//   af7_body_co.paa    colour, with the AF logo and edge wear baked in
//   af7_body_nohq.paa  normal map (DirectX style, green down)
//   af7_body_smdi.paa  green = specular, blue = gloss
//   af7_body_as.paa    green = ambient shadow

ambient[] = {1, 1, 1, 1};
diffuse[] = {1, 1, 1, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0, 0, 0, 1};
specular[] = {0.72, 0.72, 0.72, 1};
specularPower = 100;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_nohq.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage2
{
	texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,DT)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage3
{
	texture = "#(argb,8,8,3)color(0,0,0,0,MC)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage4
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_as.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage5
{
	texture = "AF_Weapons\af7_vanguard\data\af7_body_smdi.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage6
{
	texture = "#(ai,64,64,1)fresnel(3.31,4.4)";
	uvSource = "none";
};
class Stage7
{
	texture = "dz\data\data\env_land_optic_co.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
