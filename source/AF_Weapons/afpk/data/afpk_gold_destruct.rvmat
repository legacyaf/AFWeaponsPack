// The PeaceKeeper (gold sights sheet), "destruct" look: the generic overlay used by the AF-7, over the PeaceKeeper textures.

ambient[] = {1.0, 0.74, 0.42, 1};
diffuse[] = {1, 1, 1, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0.03, 0.017, 0.003, 1};     // a trace of warm lift; 0.10 made the sights glow at night (lighting series 2026-11-27)
specular[] = {1.0, 0.62, 0.18, 1};      // polished gold: a strong reflection, tinted gold (owner 2026-11-27: metallic gloss)
specularPower = 260;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "AF_Weapons\afpk\data\afpk_gold_nohq.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
