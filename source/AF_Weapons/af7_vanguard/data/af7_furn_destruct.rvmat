// Second texture set (handguard, grip, stock and butt pad): same settings as af7_body_destruct.rvmat, own textures.
// AF-7 body, "ruined" look. Values copied from the vanilla m4_body_destruct.rvmat:
// the generic destruction overlay (Stage3) tiled 4x over the normal textures.

ambient[] = {1, 1, 1, 1};
diffuse[] = {1, 1, 1, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0, 0, 0, 1};
specular[] = {1, 1, 1, 1};
specularPower = 100;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "AF_Weapons\af7_vanguard\data\af7_furn_nohq.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
