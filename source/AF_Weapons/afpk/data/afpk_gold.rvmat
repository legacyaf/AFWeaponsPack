// Material for The PeaceKeeper (gold sights sheet) ("Super" shader).
// Lighting values are the vanilla AKM's (dz\weapons\firearms\akm\data\akm.rvmat, read 2026-11-22):
// ambient 0.7, specular 0.79/0.75/0.74, power 70, fresnel(0.8,0.7), env_land_co. Only the texture paths differ.
// Textures come from blender/afpk_dayz_export.py, converted to .paa.

ambient[] = {1.0, 0.74, 0.42, 1};        // warm: in shade under a blue sky the gold read olive (owner 2026-11-27)
diffuse[] = {1, 1, 1, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0.10, 0.055, 0.008, 1};   // a little warm lift, so the sights stay gold seen from behind
specular[] = {1.0, 0.82, 0.45, 1};      // polished gold: a warm, strong highlight (2026-11-27)
specularPower = 110;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "AF_Weapons\afpk\data\afpk_gold_nohq.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage2
{
	texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,DT)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage3
{
	texture = "#(argb,8,8,3)color(0,0,0,0,MC)";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage4
{
	texture = "AF_Weapons\afpk\data\afpk_gold_as.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage5
{
	texture = "AF_Weapons\afpk\data\afpk_gold_smdi.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
};
class Stage6
{
	texture = "#(ai,32,128,1)fresnel(0.8,0.7)";
	uvSource = "none";
};
class Stage7
{
	texture = "dz\data\data\env_land_co.paa";
	uvSource = "tex";
	class uvTransform { aside[] = {1,0,0}; up[] = {0,1,0}; dir[] = {0,0,0}; pos[] = {0,0,0}; };
